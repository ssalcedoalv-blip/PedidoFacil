<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Productos: tabla del menú y formulario para agregar, editar o eliminar -->
<VBox styleClass="vista" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pedidofacil.controllers.ProductosController">
   <children>
      <HBox styleClass="fila-contenido" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="tblProductos" HBox.hgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="60.0" text="Id" />
                  <TableColumn fx:id="colNombre" prefWidth="260.0" text="Nombre" />
                  <TableColumn fx:id="colPrecio" prefWidth="120.0" styleClass="col-derecha" text="Precio" />
               </columns>
            </TableView>
            <VBox prefWidth="300.0" styleClass="panel">
               <children>
                  <Label styleClass="subtitulo" text="Producto" />
                  <Label text="Nombre" />
                  <TextField fx:id="txtNombre" promptText="Ej: Hamburguesa" />
                  <Label text="Precio (pesos)" />
                  <TextField fx:id="txtPrecio" promptText="Ej: 15000" />
                  <Button fx:id="btnAgregar" maxWidth="Infinity" onAction="#agregarProducto" styleClass="boton-primario" text="Agregar como nuevo" />
                  <Button fx:id="btnGuardar" maxWidth="Infinity" onAction="#guardarCambios" styleClass="boton-secundario" text="Guardar cambios" />
                  <Button fx:id="btnEliminar" maxWidth="Infinity" onAction="#eliminarProducto" styleClass="boton-peligro" text="Eliminar" />
                  <Button maxWidth="Infinity" onAction="#limpiarFormulario" styleClass="boton-secundario" text="Limpiar" />
                  <Label fx:id="lblMensaje" styleClass="mensaje" wrapText="true" />
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
